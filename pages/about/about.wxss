.hero {
  padding: 40rpx 24rpx 32rpx;
  text-align: center;
}
.hero-title { font-size: 40rpx; font-weight: 600; color: #222; }
.hero-sub { font-size: 24rpx; color: #999; margin-top: 12rpx; }

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #b8894a;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #c9a35c;
}
.section-body { font-size: 26rpx; color: #444; line-height: 1.7; }
.section-body .line { margin-bottom: 6rpx; }

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.row:last-child { border-bottom: none; }
.row .label { color: #888; }
.row .value { color: #333; }

.privacy {
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  padding: 24rpx 16rpx 40rpx;
}
