.header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 12rpx 8rpx 24rpx;
}
.title { font-size: 40rpx; font-weight: 600; color: #222; }
.subtitle { font-size: 22rpx; color: #999; }

.cards {
  display: flex;
  gap: 20rpx;
}
.card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.card-name { font-size: 26rpx; color: #666; }

.refresh-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f6f2e6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c9a35c;
  font-size: 32rpx;
  transition: transform 0.3s;
}
.refresh-btn.spinning { animation: spin 1s linear infinite; opacity: 0.6; }
@keyframes spin { from { transform: rotate(0deg);} to { transform: rotate(360deg);} }

.card-body {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.price { font-size: 48rpx; font-weight: 700; color: #222; }
.unit { font-size: 22rpx; color: #999; }

.card-foot {
  margin-top: 12rpx;
  font-size: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-foot .sub { color: #999; font-size: 22rpx; }

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx 0 16rpx;
  padding: 8rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  transition: background 0.2s;
}
.tab-active {
  background: #f6f2e6;
  color: #b8894a;
  font-weight: 600;
}

.chart-wrap {
  background: #fff;
  border-radius: 20rpx;
  height: 640rpx;
  padding: 16rpx;
  box-sizing: border-box;
  position: relative;
}
.chart-empty {
  position: absolute;
  top: 50%; left: 0; right: 0;
  transform: translateY(-50%);
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  padding: 32rpx 16rpx 16rpx;
}
